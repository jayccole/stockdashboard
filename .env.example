# Copy to .env for local use. In Coolify, enter these under the resource's Environment Variables.

# --- Database ---
POSTGRES_USER=stocks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocks

# --- Webull OpenAPI (webull.com -> Account Center -> OpenAPI Management) ---
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
# Optional: override the API host (leave blank to use the SDK default)
WEBULL_API_ENDPOINT=
# Optional: only ingest these watchlists (comma-separated names). Blank = all.
WEBULL_WATCHLISTS=My Watchlist

# --- AI advisor (console.anthropic.com). Leave blank to disable reviews. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Schedule (US/Eastern) ---
QUOTE_INTERVAL_MIN=5
NIGHTLY_HOUR_ET=18
NIGHTLY_MINUTE_ET=30
DAILY_BARS_LOOKBACK=300
ORDER_HISTORY_DAYS=30

# --- Dashboard sign-in: the front end asks for this token. Use a long random value. ---
DASHBOARD_TOKEN=
